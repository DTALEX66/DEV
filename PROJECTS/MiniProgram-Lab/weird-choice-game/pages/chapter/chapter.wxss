/* AD补充样式 */
.ad-choice{margin-top:20rpx;padding:28rpx 24rpx;border:1rpx solid rgba(255,180,0,0.3);border-radius:8rpx;background:rgba(255,180,0,0.05);text-align:center;}
.ad-label{color:#ffaa00;font-size:28rpx;letter-spacing:2rpx;}
.ad-choice:active{background:rgba(255,180,0,0.12);}
.terminal-tag.fragment{color:#ffaa00;border:1rpx solid rgba(255,170,0,0.3);}
