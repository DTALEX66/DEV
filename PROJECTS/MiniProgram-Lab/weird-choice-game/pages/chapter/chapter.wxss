.chapter-container { padding: 40rpx; min-height: 100vh; }
.chapter-card {
  background: rgba(255,255,255,0.04); border-radius: 20rpx;
  padding: 40rpx; margin-bottom: 40rpx;
  box-shadow: 0 0 0 1rpx rgba(255,255,255,0.08);
  opacity: 0; transform: translateY(20rpx); transition: none;
}
.chapter-card.fade-in {
  animation: fadeUp 0.5s ease forwards;
}
.chapter-title { font-size: 40rpx; color: #e94560; font-weight: bold; }
.chapter-divider { height: 2rpx; background: linear-gradient(90deg, #e94560, transparent); margin: 24rpx 0; }
.chapter-content { font-size: 30rpx; line-height: 1.8; color: #c0c0d0; white-space: pre-wrap; }
.choices-area { margin-top: 20rpx; opacity: 0; }
.choices-area.fade-in {
  animation: fadeUp 0.5s ease 0.15s forwards;
}
.choice-hint { text-align: center; color: #445566; font-size: 24rpx; margin-bottom: 20rpx; }
.choice-btn {
  display: flex; align-items: center; justify-content: center;
  background: rgba(233,69,96,0.08); box-shadow: 0 0 0 1rpx rgba(233,69,96,0.3);
  border-radius: 16rpx; padding: 28rpx 32rpx; margin-bottom: 16rpx;
  font-size: 30rpx; color: #e0e0e0; line-height: normal;
}
.choice-btn:active { background: rgba(233,69,96,0.2); }
button.choice-btn::after { border: none; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.rules-entry {
  position: fixed; top: 20rpx; right: 20rpx;
  background: rgba(233,69,96,0.15);
  padding: 12rpx 24rpx; border-radius: 30rpx;
  font-size: 24rpx; color: #e94560; z-index: 99;
}
.rules-entry:active { background: rgba(233,69,96,0.3); }
/* 氛围效果 */
.chapter-container::before {
  content: ''; position: fixed; top: 0; left: 0;
  width: 100%; height: 100%; pointer-events: none;
  background: radial-gradient(ellipse at 50% 0%, rgba(233,69,96,0.03) 0%, transparent 70%);
  animation: pulseBg 4s ease-in-out infinite; z-index: -1;
}
@keyframes pulseBg {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.chapter-card.fade-in {
  animation: fadeUp 0.6s ease forwards;
}
.choices-area.fade-in {
  animation: fadeUp 0.5s ease 0.2s forwards;
}
