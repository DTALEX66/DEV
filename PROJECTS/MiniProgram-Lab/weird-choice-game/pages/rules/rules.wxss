page { background: #0a0a0f; font-family: "Courier New", monospace; }
.terminal-rules { padding: 40rpx 32rpx; position: relative; z-index: 4; }
.rules-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 16rpx; border-bottom: 1rpx solid rgba(74,158,255,0.1);
  margin-bottom: 24rpx;
}
.rules-tag { font-size: 22rpx; color: rgba(74,158,255,0.4); letter-spacing: 2rpx; }
.rules-found { font-size: 20rpx; color: rgba(74,158,255,0.3); }
.rules-divider { height: 1rpx; background: linear-gradient(90deg,rgba(74,158,255,0.1),transparent); margin-bottom: 20rpx; }
.rule-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 16rpx; margin-bottom: 8rpx;
  border: 1rpx solid rgba(255,255,255,0.03); border-radius: 6rpx;
}
.rule-item.found { background: rgba(74,158,255,0.02); border-color: rgba(74,158,255,0.08); }
.rule-item.hidden { opacity: 0.3; }
.rule-index { font-size: 22rpx; color: rgba(74,158,255,0.5); min-width: 40rpx; letter-spacing: 1rpx; }
.rule-text { font-size: 26rpx; color: #b0b8c8; letter-spacing: 1rpx; flex: 1; }
.rule-status { font-size: 20rpx; color: rgba(255,255,255,0.1); letter-spacing: 1rpx; }
