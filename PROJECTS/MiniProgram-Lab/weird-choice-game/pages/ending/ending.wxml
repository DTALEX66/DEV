<view class="atmo-wrapper {{atmoClass}} {{fxFlicker?'fx-flicker':''}}">
  <view class="bg-layer {{atmoState}}"></view>
  <view class="bg-noise"></view>
  <view class="bg-vignette"></view>
  <view class="atmo-overlay"></view>
  <view class="terminal-ending">
    <view class="ending-content">
      <text class="ending-tag">{{endingTag}}</text>
      <text class="ending-title">{{title}}</text>
      <view class="ending-divider"></view>
      <text class="ending-text">{{content}}</text>
      <view class="ending-stats" wx:if="{{stats}}">
        <text class="stat-line">章节完成: {{stats.chapters}}</text>
        <text class="stat-line">规则发现: {{stats.rulesFound}}/{{stats.rulesTotal}}</text>
        <text class="stat-line fragment-line" wx:if="{{fragmentCount>0}}">真相碎片: {{fragmentCount}}/{{fragmentTotal}}</text>
      </view>
      <view class="ending-actions">
        <!-- 广告复活按钮（假结局/坏结局） -->
        <view wx:if="{{showRevive}}" class="end-choice ad-choice" bindtap="onWatchAd">
          <text class="end-arrow">📺</text>
          <text class="end-label ad-label">观看广告·继续实验</text>
        </view>
        <!-- 重新开始 -->
        <view wx:if="{{canRestart}}" class="end-choice" bindtap="onRestart">
          <text class="end-arrow">❯</text>
          <text class="end-label">重新开始实验</text>
        </view>
        <!-- 通关广告支持（好结局/隐藏结局） -->
        <view wx:if="{{showAdEnding}}" class="end-choice ad-support-choice" bindtap="onAdEnding">
          <text class="end-arrow">📺</text>
          <text class="end-label">观看广告支持开发者</text>
        </view>
      </view>
    </view>
  </view>
</view>