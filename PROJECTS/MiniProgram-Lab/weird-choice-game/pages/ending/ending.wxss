.ending-container {
  display: flex; flex-direction: column; align-items: center;
  min-height: 100vh; padding: 60rpx 40rpx; text-align: center;
}
.ending-badge {
  background: #e94560; color: #fff; font-size: 24rpx;
  padding: 8rpx 32rpx; border-radius: 20rpx; margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}
.ending-title { font-size: 48rpx; color: #e94560; font-weight: bold; margin-bottom: 24rpx; }
.ending-divider { width: 120rpx; height: 2rpx; background: #e94560; margin-bottom: 32rpx; }
.ending-content { font-size: 30rpx; line-height: 1.8; color: #c0c0d0; white-space: pre-wrap; }
/* 统计卡片 */
.stats-card {
  display: flex; justify-content: center; gap: 40rpx;
  margin: 32rpx 0; width: 100%;
}
.stat-item {
  background: rgba(255,255,255,0.04);
  border-radius: 16rpx; padding: 24rpx 40rpx;
  box-shadow: 0 0 0 1rpx rgba(255,255,255,0.06);
}
.stat-num { font-size: 40rpx; color: #e94560; font-weight: bold; display: block; }
.stat-label { font-size: 22rpx; color: #667; margin-top: 8rpx; display: block; }
/* 路线图 */
.route-toggle {
  color: #8899aa; font-size: 26rpx; padding: 16rpx; margin: 8rpx 0;
  border-bottom: 1rpx solid #1a1a30; width: 100%; text-align: center;
}
.route-toggle:active { color: #e94560; }
.route-list { width: 100%; padding: 20rpx 0; }
.route-node {
  display: flex; align-items: center; padding: 12rpx 0;
  border-left: 2rpx solid #333; margin-left: 20rpx; padding-left: 32rpx;
  position: relative;
}
.route-node:last-child { border-left-color: #e94560; }
.route-dot {
  position: absolute; left: -6rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #445;
}
.route-dot.first { background: #e94560; }
.route-step { font-size: 26rpx; color: #a0a0b0; }
.route-node:last-child .route-step { color: #e94560; font-weight: bold; }
/* 规则收集 */
.rules-section { width: 100%; margin-top: 24rpx; }
.rules-section-title { font-size: 24rpx; color: #667; margin-bottom: 12rpx; display: block; }
.rules-section-text {
  display: block; font-size: 26rpx; color: #c0c0d0;
  padding: 16rpx; margin-bottom: 8rpx;
  background: rgba(233,69,96,0.06); border-radius: 10rpx;
}
.restart-btn {
  width: 400rpx; height: 80rpx; margin-top: 40rpx;
  border-radius: 40rpx; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  background: #e94560; color: #fff; padding: 0; border: none; line-height: normal;
}
button.restart-btn::after { border: none; }
