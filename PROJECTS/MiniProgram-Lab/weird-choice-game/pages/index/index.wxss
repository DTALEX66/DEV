/* 首页 · 背景系统 + 终端风格 */
page { background: #0a0a0f; font-family: "Courier New", monospace; }
.terminal-home {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  z-index: 4;
}
.home-content { width: 100%; max-width: 600rpx; position: relative; }
.home-boot { margin-bottom: 60rpx; }
.boot-line {
  display: block; font-size: 22rpx; color: rgba(74,158,255,0.3);
  letter-spacing: 1rpx; margin-bottom: 8rpx;
}
.boot-done { color: rgba(74,158,255,0.5); }
.boot-warn { color: rgba(255,170,0,0.5); }
.home-title-block { margin-bottom: 16rpx; }
.home-glitch {
  display: block; font-size: 52rpx; font-weight: 800;
  color: #4a9eff; letter-spacing: 6rpx; line-height: 1.3;
  text-shadow: 0 0 20rpx rgba(74,158,255,0.3);
}
.home-subtitle {
  font-size: 24rpx; color: rgba(255,255,255,0.15);
  letter-spacing: 4rpx; margin-bottom: 40rpx;
}
.home-divider {
  height: 1rpx; background: linear-gradient(90deg, transparent, rgba(74,158,255,0.2), transparent);
  margin-bottom: 40rpx;
}
.home-start {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  padding: 28rpx; border: 1rpx solid rgba(74,158,255,0.15); border-radius: 6rpx;
  background: rgba(74,158,255,0.03); margin-bottom: 40rpx;
  opacity: 0; transition: opacity 0.5s ease;
}
.home-start.show { opacity: 1; }
.home-start:active { background: rgba(74,158,255,0.08); border-color: rgba(74,158,255,0.3); }
.start-prompt { color: #4a9eff; font-size: 32rpx; font-weight: bold; }
.start-text { font-size: 30rpx; color: #b0b8c8; letter-spacing: 6rpx; }
.start-cursor { color: #4a9eff; font-size: 30rpx; animation: cursorBlink 0.7s step-end infinite; }
@keyframes cursorBlink { 50% { opacity: 0; } }
.home-footer {
  display: flex; justify-content: space-between; padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.03);
}
.footer-text { font-size: 18rpx; color: rgba(74,158,255,0.2); letter-spacing: 1rpx; }
